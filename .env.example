# Collective AI network links (src/lib/network.ts). All optional: leave unset to use
# the production defaults shown here. No secrets belong in this file.

# Main Collective AI site
VITE_MAIN_URL=https://collectiveai-roan.vercel.app/
# "Start here" link hub
VITE_HUB_URL=https://collective-ai-start.vercel.app/
# Free AI Readiness Audit
VITE_ASSESSMENT_URL=https://the-collective-ai-assessment-platfo.vercel.app/
# Base URL of the nine division sites (no trailing slash)
VITE_DIVISIONS_URL=https://collective-ai-divisions-brown.vercel.app
# Shared lead handler. Defaults to ${VITE_DIVISIONS_URL}/api/lead
VITE_LEAD_ENDPOINT=https://collective-ai-divisions-brown.vercel.app/api/lead
